{
  "schemaVersion": 1,
  "id": "streamemotes",
  "version": "${version}",
  "name": "Stream Emotes",
  "description": "Adds your Twitch emotes to your twitch chat",
  "authors": [
    "falu",
    "azertyfun"
  ],
  "contact": {
    "homepage": "https://github.com/azertyfun/stream-emotes"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "eu.e4b4.streamemotes.StreamEmotes"
    ]
  },
  "mixins": [
    "streamemotes.mixins.json"
  ],
  "accessWidener": "streamemotes.accesswidener",
  "depends": {
    "minecraft": ">=1.21.4 <=1.21.4",
    "fabricloader": ">=0.16.8",
    "fabric-api": "*"
  }
}
